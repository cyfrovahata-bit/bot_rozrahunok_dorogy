# ==========================================================
#  Приклад конфігурації. Скопіюйте у .env і заповніть.
#  cp .env.example .env
# ==========================================================

# --- Telegram (потрібно, коли підключаємо бота) ---
# Токен від @BotFather
TELEGRAM_BOT_TOKEN=
# ID чатів менеджерів через кому (дізнатись: @userinfobot)
MANAGER_CHAT_IDS=
# Чат/група, куди падають усі нові заявки (необов'язково)
ORDERS_CHAT_ID=

# --- Розрахунок відстані ---
# offline  - таблиця міст + формула (працює без інтернету, похибка ~5-10%)
# osm      - безкоштовні Nominatim + OSRM (потрібен інтернет, ліміт ~1 запит/сек)
# google   - Google Distance Matrix (обрано; потрібен ключ нижче)
# Якщо ключ порожній — застосунок не впаде, а перейде на GEO_FALLBACK
GEO_PROVIDER=google
GEO_FALLBACK=offline
GOOGLE_MAPS_API_KEY=
# Контактний email для Nominatim (вимога їхніх правил використання)
NOMINATIM_CONTACT_EMAIL=
GEO_TIMEOUT_SECONDS=10

# --- Файли ---
DB_PATH=data/delivery.sqlite3
TARIFFS_PATH=config/tariffs.yaml
QUESTIONS_PATH=config/questions.yaml

# --- Робочий час менеджерів (для підключення до бесіди) ---
# Часовий пояс бізнесу. Сервери живуть за UTC, тому без цього
# робочі години зсунулися б на 2-3 години.
TIMEZONE=Europe/Kyiv
WORK_HOURS_START=9
WORK_HOURS_END=19
WORK_DAYS=1,2,3,4,5

# --- HTTP API ---
API_HOST=0.0.0.0
API_PORT=8000
# Токен для захисту API (будь-який довгий рядок)
API_TOKEN=
